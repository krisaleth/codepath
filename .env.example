# Biến môi trường dự kiến của CodePath.
# Sao chép thành .env và đổi các giá trị change-me. Không commit file .env.
# Các giá trị mặc định lấy từ docs/requirements.md; chưa có mã nào đọc các biến này.

# Cơ sở dữ liệu và hàng đợi
DATABASE_URL=postgresql://codepath:change-me@localhost:5432/codepath
REDIS_URL=redis://localhost:6379

# Xác thực (NFR-05): access token ngắn hạn, refresh token trong cookie httpOnly
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
ACCESS_TOKEN_TTL=15m
CORS_ORIGIN=http://localhost:5173

# Giới hạn tần suất (NFR-06), mỗi phút
RATE_LIMIT_AUTH_PER_IP=10
RATE_LIMIT_RUN_PER_USER=10
RATE_LIMIT_SUBMIT_PER_USER=5

# Sandbox (§3.6, BR-13)
SANDBOX_MAX_CODE_BYTES=65536
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_DEFAULT_TIME_LIMIT_MS=2000
SANDBOX_MAX_TIME_LIMIT_MS=10000
SANDBOX_DEFAULT_MEMORY_MB=256
SANDBOX_MAX_MEMORY_MB=512

# Chấm bài và phục hồi (§3.3, §3.4)
GRADING_RUNNING_TIMEOUT_SECONDS=120
GRADING_QUEUED_TIMEOUT_SECONDS=300
GRADING_MAX_REQUEUE=3
ASSESSMENT_GRACE_SECONDS=10
SCHEDULER_INTERVAL_SECONDS=30
